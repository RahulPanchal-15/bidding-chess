# HD wallet mnemonic (12/24 words) — first account (index 0) is the deployer
MNEMONIC="your twelve or twenty four word phrase here"

# Sepolia JSON-RPC (Infura, Alchemy, or other)
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_PROJECT_ID"

# Optional: reuse an already-deployed Ubiquito (skip token deploy)
# UBIQUITO_ADDRESS="0x..."

# Optional: ETH sent to ChessFactory on deploy (default 0.1)
# FACTORY_ETH="0.1"
